#!/usr/bin/env python3
"""USB SSH / Frida control for the documented rootless iOS 16 profile.

See README.md and EXTENDING.md beside this file. Nothing starts on import.
"""
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time
lazy import base64
lazy import importlib.metadata
lazy import plistlib
lazy import shutil
lazy import threading
lazy import frida

HERE = Path(__file__).resolve().parent
CAMERA = "Camera"
SPRINGBOARD = "SpringBoard"
RESOLUTIONS = frozendict({"4k":"4k", "1080p":"hd", "720p":"720p"})
WORKER_ACTIONS = ("start", "stop", "toggle", "photo", "voice-start", "voice-stop",
                  "voice-toggle", "scan-microphones", "scan-camera", "upload-ram", "stream-ram",
                  "prepare-native", "test-connection")


def positive(value):
    number = float(value)
    if not 0 < number <= 3600:
        raise argparse.ArgumentTypeError("must be greater than 0 and at most 3600")
    return number


def port_number(value):
    number = int(value)
    if not 1 <= number <= 65535:
        raise argparse.ArgumentTypeError("port must be 1..65535")
    return number


def parser():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--target", default=os.environ.get("IPHONE_SSH_TARGET", "mobile@127.0.0.1"))
    p.add_argument("--port", type=port_number, default=os.environ.get("IPHONE_SSH_PORT", "2222"))
    p.add_argument("--identity", type=Path, help="SSH identity file")
    p.add_argument("--control-path", help="existing SSH multiplexing socket; never created automatically")
    p.add_argument("--frida", default=os.environ.get("IPHONE_FRIDA_ENDPOINT", "127.0.0.1:27047"))
    p.add_argument("--process", help="process executable basename for UI inspection/custom JS")
    p.add_argument("--pid", type=int, help="explicit PID instead of name discovery")
    p.add_argument("--timeout", type=positive, default=30, help="SSH/RPC wait seconds (default 30)")
    sub = p.add_subparsers(dest="command", required=True)
    d = sub.add_parser("doctor", help="local requirements; --phone also checks USB SSH")
    d.add_argument("--phone", action="store_true")
    sub.add_parser("ps", help="read fresh device PID/executable pairs over SSH")
    sub.add_parser("usb", help="foreground iproxy for SSH; reuse an existing listener instead")
    t = sub.add_parser("tunnel", help="foreground SSH forward to the already running Frida server")
    t.add_argument("--local-port", type=port_number, default=27047)
    t.add_argument("--device-port", type=port_number, default=27042)
    sub.add_parser("shell", help="interactive SSH; normal password prompting allowed")
    s = sub.add_parser("ssh", help="run a device argv vector, shell-quoted once")
    s.add_argument("argv", nargs=argparse.REMAINDER)
    for command in ("get", "put"):
        s = sub.add_parser(command, help="copy one file using scp; paths may contain spaces")
        s.add_argument("source"); s.add_argument("destination")
    sub.add_parser("status", help="current SpringBoard PID, display, UI lock and Duskie modules")
    sub.add_parser("apps", help="installed app bundle IDs and displayed names")
    s = sub.add_parser("launch", help="launch an installed app through SpringBoard")
    s.add_argument("bundle_id")
    for command in ("home", "wake", "sleep", "lock", "unlock", "duskie-unlock"):
        sub.add_parser(command, help={"home":"Home action", "wake":"wake display only",
            "sleep":"ensure display off; does not toggle an already-off display",
            "lock":"lock UI", "unlock":"documented no-passcode UI unlock; see README", "duskie-unlock":"authenticate the installed Duskie simulated lock"}[command])
    s = sub.add_parser("screenshot", help="PNG to the host, without a phone-side output file")
    s.add_argument("output", type=Path)
    sub.add_parser("controllers", help="controller hierarchy in --process (default SpringBoard)")
    s = sub.add_parser("ui", help="bounded native view tree; text/identifiers, not OCR")
    s.add_argument("--max-nodes", type=int, default=800)
    sub.add_parser("alerts", help="read current UIAlertController titles/messages")
    sub.add_parser("dismiss-alert", help="dismiss a presented alert without choosing an action")
    s = sub.add_parser("tap", help="send TouchUpInside to one matching UIControl")
    match = s.add_mutually_exclusive_group(required=True)
    match.add_argument("--id", dest="identifier"); match.add_argument("--label")
    s = sub.add_parser("methods", help="instance or class selector names and exact type encodings")
    s.add_argument("class_name"); s.add_argument("--class-methods", action="store_true")
    s.add_argument("--matching", default="")
    s = sub.add_parser("modules", help="loaded Mach-O modules in the selected process")
    s.add_argument("--matching", default="")
    s = sub.add_parser("notify", help="post one Darwin notification; receipt is not completion")
    s.add_argument("name")
    s = sub.add_parser("js", help="custom JS defining rpc.exports.run(parameters); helpers supplied")
    s.add_argument("file", type=Path); s.add_argument("--args", default="{}", dest="js_args")
    s = sub.add_parser("camera", help="native Apple Camera; launch/unlock it first")
    cs = s.add_subparsers(dest="camera_action", required=True)
    for name in ("status", "format", "start", "stop", "photo", "fps-next", "resolution-next"):
        cs.add_parser(name)
    m = cs.add_parser("mode"); m.add_argument("mode", choices=("photo", "video", "slowmo"))
    f = cs.add_parser("set-format", help="cycle native controls and verify their displayed labels")
    f.add_argument("--resolution", required=True, choices=("4k", "1080p", "720p"))
    f.add_argument("--fps", required=True, type=int, choices=(24,25,30,50,60,120,240))
    s = sub.add_parser("worker", help="installed Duskie worker, independent of native Camera")
    s.add_argument("action", choices=(*WORKER_ACTIONS, "status"))
    s.add_argument("--path", default="/var/jb/usr/libexec/duskie-camera")
    s.add_argument("--status-path", default="/var/mobile/Media/DuskieCamera/status.plist")
    return p


class Phone:
    def __init__(self, args):
        self.args = args
        self.device = self.session = self.script = None

    def ssh_base(self, interactive=False):
        command = ["ssh", "-p", str(self.args.port), "-o", "ConnectTimeout=8"]
        if not interactive:
            command += ["-o", "BatchMode=yes"]
        if self.args.identity:
            command += ["-i", str(self.args.identity.expanduser())]
        if self.args.control_path:
            command += ["-S", self.args.control_path]
        return command

    def remote(self, argv):
        return subprocess.check_output(self.ssh_base() + [self.args.target, shlex.join(argv)],
                                       timeout=self.args.timeout)

    def processes(self):
        return parse_processes(self.remote(["ps", "-A", "-o", "pid,comm"]).decode("utf-8"))

    def connect(self, default_process):
        try:
            version = frida.__version__
        except ImportError as error:
            raise RuntimeError("Frida is not importable in this Python. See README setup; --help/SSH commands need no Frida.") from error
        if self.args.pid:
            pid = self.args.pid
        else:
            wanted = self.args.process or default_process
            found = [p for p in self.processes() if Path(p["executable"]).name == wanted]
            if len(found) != 1:
                raise RuntimeError(f"Expected one running {wanted!r}, found {len(found)}. Use ps, launch the app, or specify --pid.")
            pid = found[0]["pid"]
        source = (HERE / "runtime.js").read_text(encoding="utf-8")
        if self.args.command == "js":
            source += "\n" + self.args.file.read_text(encoding="utf-8")
        self.device = frida.get_device_manager().add_remote_device(self.args.frida)
        self.session = self.device.attach(pid)
        self.script = self.session.create_script(source)
        self.script.on("message", lambda message, data: print(
            json.dumps({"frida_message": message}, ensure_ascii=False), file=sys.stderr))
        self.script.load()
        return {"pid":pid, "clientFrida":version}

    def rpc(self, action, parameters=None):
        # Cancellation ends the host wait; it cannot roll back a queued native action.
        cancellable = frida.Cancellable()
        timer = threading.Timer(self.args.timeout, cancellable.cancel)
        timer.daemon = True
        timer.start()
        try:
            with cancellable:
                if action == "custom":
                    return self.script.exports_sync.run(parameters)
                return self.script.exports_sync.execute(action, parameters or {})
        finally:
            timer.cancel()

    def close(self):
        if self.session is not None:
            try:
                self.session.detach()
            except Exception as error:
                print(f"Detach: {error}", file=sys.stderr)


def parse_processes(text):
    out = []
    for line in text.splitlines():
        fields = line.strip().split(maxsplit=1)
        if len(fields) == 2 and fields[0].isdigit():
            out.append({"pid":int(fields[0]), "executable":fields[1]})
    return out


def emit(result):
    print(json.dumps(result, ensure_ascii=False, indent=2))


def format_matches(state, resolution, fps):
    return state["resolutionLabel"].casefold() == RESOLUTIONS[resolution] and state["fpsLabel"] == str(fps)


def set_format(phone, resolution, fps):
    state = phone.rpc("camera.status")
    if state["recording"]:
        raise RuntimeError("Stop native recording before changing its format")
    if state["mode"] not in (1, 2):
        phone.rpc("camera.mode", {"mode":1})
        time.sleep(0.6)
    original = phone.rpc("camera.format")
    desired = RESOLUTIONS[resolution]
    seen = set()
    for _ in range(12):
        state = phone.rpc("camera.format")
        if state["resolutionLabel"].casefold() == desired:
            break
        key = (state["configuration"], state["resolutionLabel"])
        if key in seen:
            raise RuntimeError(f"Resolution {resolution} not reached through native controls; current={state}. Original={original}")
        seen.add(key); phone.rpc("camera.resolution-next"); time.sleep(0.5)
    else:
        raise RuntimeError(f"Resolution change did not settle. Original={original}")
    seen.clear()
    for _ in range(12):
        state = phone.rpc("camera.format")
        if format_matches(state, resolution, fps):
            return {"before":original, "after":state, "verifiedBy":"native displayed labels; verify encoded media separately"}
        key = (state["configuration"], state["fpsLabel"])
        if key in seen:
            raise RuntimeError(f"Requested frame rate not reached; current={state}. Original={original}")
        seen.add(key); phone.rpc("camera.fps-next"); time.sleep(0.5)
    raise RuntimeError(f"Frame rate change did not settle. Original={original}")


def run(args):
    phone = Phone(args)
    try:
        command = args.command
        if command == "doctor":
            result = {"python":sys.version, "pythonExecutable":sys.executable,
                      "runtimeExists":(HERE/"runtime.js").is_file(),
                      "tools":{name:shutil.which(name) for name in ("ssh","scp","iproxy","node","ffprobe","ffmpeg")}}
            try:
                result["fridaDistribution"] = importlib.metadata.version("frida")
            except importlib.metadata.PackageNotFoundError:
                result["fridaDistribution"] = None
            if args.phone:
                result["phone"] = phone.remote(["uname","-a"]).decode("utf-8").strip()
                result["processes"] = phone.processes()
            return emit(result)
        if command == "ps":
            return emit(phone.processes())
        if command == "usb":
            return subprocess.run(["iproxy","-s","127.0.0.1",f"{args.port}:22"], check=True).returncode
        if command == "tunnel":
            return subprocess.run(phone.ssh_base() + ["-N","-o","ExitOnForwardFailure=yes","-L",
                f"127.0.0.1:{args.local_port}:127.0.0.1:{args.device_port}",args.target], check=True).returncode
        if command == "shell":
            return subprocess.run(phone.ssh_base(interactive=True)+["-t",args.target], check=True).returncode
        if command == "ssh":
            argv = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
            if not argv:
                raise ValueError("ssh requires a device command after --")
            sys.stdout.buffer.write(phone.remote(argv));return
        if command in ("get","put"):
            scp = ["scp","-P",str(args.port),"-o","BatchMode=yes"]
            if args.identity:
                scp += ["-i",str(args.identity.expanduser())]
            if args.control_path:
                scp += ["-o",f"ControlPath={args.control_path}"]
            source, destination = args.source, args.destination
            if command == "get":
                source = f"{args.target}:{source}";destination = str(Path(destination).expanduser().absolute())
            else:
                source = str(Path(source).expanduser().absolute());destination = f"{args.target}:{destination}"
            return subprocess.run(scp+[source,destination],check=True,timeout=args.timeout).returncode
        if command == "worker":
            if args.action == "status":
                return emit(plistlib.loads(phone.remote(["cat",args.status_path])))
            # The elected helper owns recording/upload lifetime. Keep this SSH
            # process attached until it exits; stop/status use another terminal.
            return subprocess.run(phone.ssh_base()+[args.target,shlex.join([args.path,args.action])],
                                  check=True).returncode
        custom_parameters = json.loads(args.js_args) if command == "js" else None
        default = CAMERA if command == "camera" else SPRINGBOARD
        connection = phone.connect(default)
        if command == "camera":
            if args.camera_action == "set-format":
                return emit(set_format(phone,args.resolution,args.fps))
            action = "camera."+args.camera_action
            parameters = {"mode":{"photo":0,"video":1,"slowmo":2}[args.mode]} if args.camera_action == "mode" else {}
        else:
            action = "custom" if command == "js" else command
            parameters = {key:getattr(args,key) for key in ("bundle_id","max_nodes","identifier","label","class_name","class_methods","matching","name") if hasattr(args,key)}
            if command == "js":
                parameters = custom_parameters
        result = phone.rpc(action,parameters)
        if command == "screenshot":
            args.output.write_bytes(base64.b64decode(result.pop("pngBase64"),validate=True))
            result["output"] = str(args.output.absolute())
        return emit({"connection":connection, "result":result})
    finally:
        phone.close()


def main():
    try:
        return run(parser().parse_args()) or 0
    except KeyboardInterrupt:
        print("Interrupted. Read the phone's actual state before retrying a mutating command.",file=sys.stderr);return 130
    except Exception as error:
        print(f"iphone-control: {error}",file=sys.stderr);return 1


if __name__ == "__main__":
    raise SystemExit(main())
