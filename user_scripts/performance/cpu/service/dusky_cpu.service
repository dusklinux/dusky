[Unit]
Description=Dusky CPU Core and Power Limiter Restorer
After=local-fs.target systemd-modules-load.service tlp.service thermald.service asusd.service
Before=multi-user.target
# Expanded for the installing user by the Dusky service manager.
RequiresMountsFor="$HOME"

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="HOME=$HOME" "SUDO_USER=$USER" "PATH=/usr/local/bin:/usr/bin"
ExecStart=/usr/bin/env python3 "$HOME/user_scripts/performance/cpu/tui_dusky_core_manager.py" --restore-all

[Install]
WantedBy=multi-user.target
