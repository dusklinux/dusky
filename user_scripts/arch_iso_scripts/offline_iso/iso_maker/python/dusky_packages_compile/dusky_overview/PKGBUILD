pkgname=dusky-overview
pkgver=0.1.0
pkgrel=1
pkgdesc='Dusky Overview workspace switcher for Hyprland'
arch=('x86_64')
license=('MIT')
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd')
makedepends=('cargo' 'python')
options=('!debug')
source=('build_rust.py' '147_rust_compiles_shared_NOT_STANDALONE.py')
# Local sources are fingerprinted by the ISO generator together with this recipe.
sha256sums=('SKIP' 'SKIP')

build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE" "$srcdir/project"
  python "$srcdir/build_rust.py" "$srcdir/project" "$srcdir/binary-output/dusky_overview"
}

package() {
  install -Dm755 "$srcdir/binary-output/dusky_overview" \
    "$pkgdir/usr/bin/dusky_overview"
  ln -sf "dusky_overview" "$pkgdir/usr/bin/dusky-overview"

  install -d "$pkgdir/usr/share/dusky-overview"
  install -d "$pkgdir/usr/share/dusky_overview"

  python - "$srcdir/project" "$srcdir" > "$pkgdir/usr/share/dusky-overview/source.sha256" <<'PY'
import hashlib
import sys
from pathlib import Path
from importlib import import_module

project = Path(sys.argv[1])
sys.path.insert(0, sys.argv[2])
build_support = import_module("147_rust_compiles_shared_NOT_STANDALONE")

files = [project / "Cargo.toml"]
if (project / "Cargo.lock").is_file():
    files.append(project / "Cargo.lock")
for relative in (
    "build.rs", "rust-toolchain", "rust-toolchain.toml",
    ".cargo/config", ".cargo/config.toml",
):
    path = project / relative
    if path.is_file():
        files.append(path)
if (project / "src").is_dir():
    files.extend(sorted(path for path in (project / "src").rglob("*") if path.is_file()))
files.extend(build_support.font_source_files())

digest = hashlib.sha256(b"overview-native-v2-fat-lto-tmpfs\0")
for path in files:
    with path.open("rb") as stream:
        file_hash = hashlib.file_digest(stream, "sha256").digest()
    digest.update(str(path.relative_to(project, walk_up=True)).encode())
    digest.update(b"\0")
    digest.update(file_hash)
print(digest.hexdigest())
PY

  cp -a "$pkgdir/usr/share/dusky-overview/source.sha256" "$pkgdir/usr/share/dusky_overview/source.sha256"
}
