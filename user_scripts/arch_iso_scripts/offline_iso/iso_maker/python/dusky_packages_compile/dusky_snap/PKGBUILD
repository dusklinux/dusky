pkgname=dusky_snap
pkgver=0.4.2
pkgrel=7
pkgdesc='Dusky Snap Wayland screenshot and annotation tool'
arch=('x86_64')
license=('custom')
depends=('glibc' 'libgcc' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd'
         'hyprland' 'wl-clipboard' 'xdg-utils' 'xdg-user-dirs' 'tesseract' 'tesseract-data-eng')
makedepends=('cargo' 'python')
options=('!debug' '!strip')
build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE" "$srcdir/project"
  python "$DUSKY_BUILD_RUST" "$srcdir/project" "$srcdir/binary-output/dusky_snap"
}

package() {
  install -Dm755 "$srcdir/binary-output/dusky_snap" \
    "$pkgdir/usr/bin/dusky_snap"
  install -Dm644 "$srcdir/project/config.json" "$pkgdir/usr/share/dusky_snap/config.json"
  install -Dm644 "$srcdir/project/dusky_snap.desktop" \
    "$pkgdir/usr/share/applications/dusky_snap.desktop"
  python - "$srcdir/project" "$DUSKY_BUILD_RUST" > "$pkgdir/usr/share/dusky_snap/source.sha256" <<'PYHASH'
import sys
from pathlib import Path

project = Path(sys.argv[1])
sys.path.insert(0, str(Path(sys.argv[2]).resolve().parent))
from build_rust import shared
print(shared.source_digest(project, recipe="snap-rust-v3-native-first-frozen-tmpfs"))
PYHASH
}
