pkgname=example-package
pkgver=1.0.0
pkgrel=1
pkgdesc='Example package built by the Dusky ISO factory'
arch=('x86_64')
license=('custom')
depends=('glibc')
makedepends=('cargo' 'python')
build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE" "$srcdir/project"
  python "$DUSKY_BUILD_RUST" "$srcdir/project" "$srcdir/binary-output/example-package"
}

package() {
  install -Dm755 "$srcdir/binary-output/example-package" \
    "$pkgdir/usr/bin/example-package"
}
