pkgname=example-package
pkgver=1.0.0
pkgrel=1
pkgdesc='Example package built by the Dusky ISO factory'
arch=('x86_64')
license=('custom')
depends=('glibc')
makedepends=('cargo' 'python')
source=('build_rust.py' '147_rust_compiles_shared_NOT_STANDALONE.py')
sha256sums=('SKIP' 'SKIP')

build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE" "$srcdir/project"
  python "$srcdir/build_rust.py" "$srcdir/project" "$srcdir/binary-output/example-package"
}

package() {
  install -Dm755 "$srcdir/binary-output/example-package" \
    "$pkgdir/usr/bin/example-package"
}
