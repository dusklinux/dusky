pkgname=dusky_tray
pkgver=1.0.0
pkgrel=8
pkgdesc='Dusky Tray control center for Hyprland'
arch=('x86_64')
license=('custom')
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd')
makedepends=('cargo' 'python' 'gcc' 'wayland')
build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE/dusky_tray" "$srcdir/project"
  mkdir -- "$srcdir/click_away_to_dismiss"
  cp -- "$DUSKY_PACKAGE_SOURCE/click_away_to_dismiss/"{dusky.c,hyprland_focus_grab_v1.xml} "$srcdir/click_away_to_dismiss/"
  python "$DUSKY_BUILD_RUST" "$srcdir/project" "$srcdir/binary-output/dusky_tray"
}

package() {
  install -Dm755 "$srcdir/binary-output/dusky_tray" \
    "$pkgdir/usr/bin/dusky_tray"
  install -Dm644 "$srcdir/project/appearance.toml" \
    "$pkgdir/usr/share/dusky_tray/appearance.toml"
  install -Dm644 "$srcdir/project/ignored_apps.toml" \
    "$pkgdir/usr/share/dusky_tray/ignored_apps.toml"
  install -Dm644 "$srcdir/project/config.toml" \
    "$pkgdir/usr/share/dusky_tray/config.toml"
  python - "$srcdir/project" "$DUSKY_BUILD_RUST" > "$pkgdir/usr/share/dusky_tray/source.sha256" <<'PY'
import sys
from pathlib import Path

project = Path(sys.argv[1])
sys.path.insert(0, str(Path(sys.argv[2]).resolve().parent))
from build_rust import shared

extra = (
    project.parent / "click_away_to_dismiss/dusky.c",
    project.parent / "click_away_to_dismiss/hyprland_focus_grab_v1.xml",
)
print(shared.source_digest(project, recipe="tray-native-v1-frozen-tmpfs", extra_files=extra))
PY
}
