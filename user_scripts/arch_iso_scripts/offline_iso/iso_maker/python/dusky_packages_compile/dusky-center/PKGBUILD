pkgname=dusky-center
pkgver=1.0.0
pkgrel=1
pkgdesc='Dusky Center control center for Hyprland'
arch=('x86_64')
license=('custom')
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd')
makedepends=('cargo' 'python')
options=('!debug')
source=('build_rust.py' '147_rust_compiles_shared_NOT_STANDALONE.py')
# Local sources are fingerprinted by the ISO generator together with this recipe.
sha256sums=('SKIP' 'SKIP')

build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE" "$srcdir/project"
  python "$srcdir/build_rust.py" "$srcdir/project" "$srcdir/binary-output/dusky-center"
}

package() {
  install -Dm755 "$srcdir/binary-output/dusky-center" \
    "$pkgdir/usr/bin/dusky-center"
  install -Dm644 "$srcdir/project/dusky_config.toml" \
    "$pkgdir/usr/share/dusky-center/dusky_config.toml"
  python - "$srcdir/project" > "$pkgdir/usr/share/dusky-center/source.sha256" <<'PY'
import hashlib
import sys
from pathlib import Path

project = Path(sys.argv[1])
files = [project / "Cargo.toml", project / "Cargo.lock"]
for relative in (
    "build.rs", "rust-toolchain", "rust-toolchain.toml",
    ".cargo/config", ".cargo/config.toml",
):
    path = project / relative
    if path.is_file():
        files.append(path)
if (project / "src").is_dir():
    files.extend(sorted(path for path in (project / "src").rglob("*") if path.is_file()))

# Same inputs and recipe marker as 153_dusky_center_setup.py.
digest = hashlib.sha256(b"center-native-v1-frozen-tmpfs\0")
for path in files:
    digest.update(str(path.relative_to(project)).encode())
    digest.update(b"\0")
    digest.update(hashlib.sha256(path.read_bytes()).digest())
print(digest.hexdigest())
PY
}
