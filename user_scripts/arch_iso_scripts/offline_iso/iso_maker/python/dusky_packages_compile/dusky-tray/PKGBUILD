pkgname=dusky-tray
pkgver=1.0.0
pkgrel=7
pkgdesc='Dusky Tray control center for Hyprland'
arch=('x86_64')
license=('custom')
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd')
makedepends=('cargo' 'python' 'gcc')
source=('build_rust.py' '147_rust_compiles_shared_NOT_STANDALONE.py')
# Local sources are fingerprinted by the ISO generator together with this recipe.
sha256sums=('SKIP' 'SKIP')

build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE/dusky_tray" "$srcdir/project"
  mkdir -- "$srcdir/click_away_to_dismiss"
  cp -- "$DUSKY_PACKAGE_SOURCE/click_away_to_dismiss/"{dusky.c,hyprland-focus-grab-v1-client-protocol.c,hyprland-focus-grab-v1-client-protocol.h} "$srcdir/click_away_to_dismiss/"
  python "$srcdir/build_rust.py" "$srcdir/project" "$srcdir/binary-output/dusky-tray"
}

package() {
  install -Dm755 "$srcdir/binary-output/dusky-tray" \
    "$pkgdir/usr/bin/dusky-tray"
  install -Dm644 "$srcdir/project/appearance.toml" \
    "$pkgdir/usr/share/dusky-tray/appearance.toml"
  install -Dm644 "$srcdir/project/ignored_apps.toml" \
    "$pkgdir/usr/share/dusky-tray/ignored_apps.toml"
  install -Dm644 "$srcdir/project/config.toml" \
    "$pkgdir/usr/share/dusky-tray/config.toml"
  python - "$srcdir/project" > "$pkgdir/usr/share/dusky-tray/source.sha256" <<'PY'
import hashlib
import os
import sys
from pathlib import Path

project = Path(sys.argv[1])
files = [project / "Cargo.toml", project / "Cargo.lock"]
for relative in (
    "build.rs", "rust-toolchain", "rust-toolchain.toml",
    ".cargo/config", ".cargo/config.toml",
):
    path = project / relative
    if path.is_file():
        files.append(path)
if (project / "src").is_dir():
    files.extend(sorted(path for path in (project / "src").rglob("*") if path.is_file()))

files.extend(project.parent / "click_away_to_dismiss" / name for name in (
    "dusky.c",
    "hyprland-focus-grab-v1-client-protocol.c",
    "hyprland-focus-grab-v1-client-protocol.h",
))

# Same inputs and recipe marker as 152_dusky_tray_setup.py.
digest = hashlib.sha256(b"tray-native-v1-frozen-tmpfs\0")
for path in files:
    digest.update(os.path.relpath(path, project).encode())
    digest.update(b"\0")
    digest.update(hashlib.sha256(path.read_bytes()).digest())
print(digest.hexdigest())
PY
}
