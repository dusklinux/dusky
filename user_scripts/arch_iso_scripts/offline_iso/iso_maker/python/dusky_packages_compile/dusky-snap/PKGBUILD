pkgname=dusky-snap
pkgver=0.4.1
pkgrel=3
pkgdesc='Dusky Snap Wayland screenshot and annotation tool'
arch=('x86_64')
license=('custom')
depends=('glibc' 'libgcc' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd'
         'hyprland' 'wl-clipboard' 'xdg-utils' 'xdg-user-dirs' 'tesseract' 'tesseract-data-eng')
makedepends=('cargo' 'python')
options=('!debug' '!strip')
source=('build_rust.py' '147_rust_compiles_shared_NOT_STANDALONE.py')
# Local sources are fingerprinted by the ISO generator together with this recipe.
sha256sums=('SKIP' 'SKIP')

build() {
  cp -aL -- "$DUSKY_PACKAGE_SOURCE" "$srcdir/project"
  python "$srcdir/build_rust.py" "$srcdir/project" "$srcdir/binary-output/dusky_snap"
}

package() {
  install -Dm755 "$srcdir/binary-output/dusky_snap" \
    "$pkgdir/usr/bin/dusky_snap"
  install -Dm644 "$srcdir/project/config.json" "$pkgdir/usr/share/dusky-snap/config.json"
  install -Dm644 "$srcdir/project/dusky_snap.desktop" \
    "$pkgdir/usr/share/applications/dusky_snap.desktop"
  python - "$srcdir/project" > "$pkgdir/usr/share/dusky-snap/source.sha256" <<'PYHASH'
import hashlib
import sys
from pathlib import Path

project = Path(sys.argv[1])
files = [project / "Cargo.toml", project / "Cargo.lock"]
for relative in (
    "build.rs", "rust-toolchain", "rust-toolchain.toml",
    ".cargo/config", ".cargo/config.toml",
):
    path = project / relative
    if path.is_file():
        files.append(path)
if (project / "src").is_dir():
    files.extend(sorted(path for path in (project / "src").rglob("*") if path.is_file()))

# Same build inputs and recipe marker as 150_dusky_snap_setup.py.
digest = hashlib.sha256(b"snap-rust-v3-native-first-frozen-tmpfs\0")
for path in files:
    digest.update(str(path.relative_to(project)).encode())
    digest.update(b"\0")
    digest.update(hashlib.sha256(path.read_bytes()).digest())
print(digest.hexdigest())
PYHASH
}
