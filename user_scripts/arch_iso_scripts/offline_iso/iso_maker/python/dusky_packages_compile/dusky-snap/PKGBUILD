pkgname=dusky-snap
pkgver=0.4.1
pkgrel=2
pkgdesc='Dusky Snap Wayland screenshot and annotation tool'
arch=('x86_64')
license=('custom')
depends=('glibc' 'libgcc' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'mesa' 'libglvnd'
         'hyprland' 'wl-clipboard' 'xdg-utils' 'xdg-user-dirs' 'tesseract' 'tesseract-data-eng')
makedepends=('cargo' 'util-linux')
options=('!debug' '!strip')
source=()

build() {
  # The ISO must run on baseline x86-64 CPUs, regardless of the builder's CPU.
  [[ "$(findmnt -n -o FSTYPE -T /tmp)" == tmpfs ]] || {
    printf 'Dusky Snap ISO builds require /tmp on tmpfs.\n' >&2
    return 1
  }
  local build_dir
  build_dir="$(mktemp -d /tmp/dusky-snap-iso.XXXXXXXX)"
  printf '%s\n' "$build_dir" > "$srcdir/snap-build-path"
  trap "status=\$?; if ((status != 0)); then rm -rf -- '$build_dir'; fi" EXIT
  cp -a -- "$DUSKY_PACKAGE_SOURCE" "$build_dir/project"
  cd "$build_dir/project"
  unset CARGO_ENCODED_RUSTFLAGS
  export RUSTFLAGS='-C target-cpu=x86-64'
  export CFLAGS='-march=x86-64 -mtune=generic -O2'
  export CXXFLAGS="$CFLAGS"
  export CPPFLAGS=''
  export CARGO_TARGET_DIR="$build_dir/target"
  export CARGO_BUILD_BUILD_DIR="$CARGO_TARGET_DIR"
  export TMPDIR="$build_dir"
  export RUSTUP_AUTO_INSTALL=0
  # ISO creation can fetch missing crates; the installed package is fully offline.
  cargo fetch --locked --target x86_64-unknown-linux-gnu
  export CARGO_NET_OFFLINE=true
  cargo build --release --frozen --target x86_64-unknown-linux-gnu \
    --jobs "${CARGO_BUILD_JOBS:-2}" --bin dusky_snap
}

package() {
  local build_dir
  build_dir="$(cat "$srcdir/snap-build-path")"
  trap "rm -rf -- '$build_dir'" EXIT
  install -Dm755 "$build_dir/target/x86_64-unknown-linux-gnu/release/dusky_snap" \
    "$pkgdir/usr/bin/dusky_snap"
  install -Dm644 "$build_dir/project/config.json" "$pkgdir/usr/share/dusky-snap/config.json"
  install -Dm644 "$build_dir/project/dusky_snap.desktop" \
    "$pkgdir/usr/share/applications/dusky_snap.desktop"
}
