[Unit]
Description=Dusky Audio Visualizer Daemon
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=exec

# Keep Python logs unbuffered in the journal.
Environment=PYTHONUNBUFFERED=1

# Force GTK to use Wayland. This daemon requires gtk-layer-shell.
Environment=GDK_BACKEND=wayland

# Match the PATH-selected Python used by the scripts (ISO baseline: Python 3.15+).
ExecStart=/usr/bin/env python3 %h/user_scripts/way_layers/visualizer/visualizer_daemon.py

Restart=on-failure
RestartSec=2

TimeoutStopSec=5s
TimeoutStopFailureMode=kill

KillMode=control-group
NoNewPrivileges=true
UMask=077

# Account for memory without fixed caps on display/driver-dependent allocations.
MemoryAccounting=yes
OOMPolicy=kill
OOMScoreAdjust=400

[Install]
WantedBy=graphical-session.target
