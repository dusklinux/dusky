[Unit]
Description=Waybar network speed daemon
# HOOK 1: Wait until the graphical session is actually ready
After=graphical-session.target

# HOOK 2: Bind the lifecycle to the graphical session.
# If the graphical session stops, this service is stopped.
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Ensure this path matches where you saved the daemon
ExecStart=%h/user_scripts/waybar/network/network_meter_daemon.sh
Restart=always
RestartSec=1s
OOMPolicy=kill
OOMScoreAdjust=400
SuccessExitStatus=0 143

# Hardening (Keep your system safe)
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
# NoNewPrivileges is good for scripts not needing sudo
NoNewPrivileges=true

[Install]
# HOOK 3: This tells systemd to launch this ONLY when a graphical session starts
WantedBy=graphical-session.target
