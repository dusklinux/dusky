[Unit]
Description=Dusky Notification Timestamp Tracking Daemon
Documentation=https://github.com/dusky
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/user_scripts/dusky_system/dusky_tray/service/notification_time_service/dusky_notif_time.py
Restart=on-failure
RestartSec=3s
Slice=session.slice

[Install]
WantedBy=graphical-session.target
