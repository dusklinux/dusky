# Optional on-demand unit after scripts/build-on-tmpfs.sh --install.
# Start explicitly with systemctl --user start dusky_tray.service.
# No [Install] section: this panel must not start at login or restart on close.
[Unit]
Description=Dusky Tray (on demand)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/dusky-tray
Slice=app-graphical.slice
Restart=no
TimeoutStopSec=2s
SyslogIdentifier=dusky-tray
