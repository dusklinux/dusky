[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Scheduling Dusky Update Checker for active user managers...
When = PostTransaction
Exec = /usr/bin/bash -c 'shopt -s nullglob; for dir in /run/user/[0-9]*; do [[ -d "$dir" ]] || continue; IFS=: read -r user _ < <(getent passwd "${dir##*/}" 2>/dev/null) || continue; runuser -u "$user" -- env XDG_RUNTIME_DIR="$dir" systemctl --user --no-block start update_checker.service || true; done; exit 0'
