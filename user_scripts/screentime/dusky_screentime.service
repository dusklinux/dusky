[Unit]
Description=Dusky Screentime Tracking Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1 PYTHONOPTIMIZE=2 MALLOC_ARENA_MAX=1
ExecSearchPath=/usr/local/bin:/usr/bin
ExecStart=python3 "%h/user_scripts/screentime/screentime_daemon.py"
Slice=app-graphical.slice
OOMPolicy=kill
OOMScoreAdjust=400
Restart=on-failure
RestartSec=2
TimeoutStopSec=10s
TimeoutStopFailureMode=kill
MemoryAccounting=yes

[Install]
WantedBy=graphical-session.target
