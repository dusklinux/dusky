# ~/.config/systemd/user/dusky_kokoro.service
#
# Socket-activated: enable dusky_kokoro.socket, never this unit directly.
#   systemctl --user enable --now dusky_kokoro.socket
[Unit]
Description=Dusky Kokoro TTS daemon (Kokoro-ONNX, socket-activated, exits when idle)
Requires=dusky_kokoro.socket
After=dusky_kokoro.socket pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart="%h/contained_apps/uv/dusky_kokoro/.venv/bin/python" -X utf8 -u "%h/contained_apps/uv/dusky_kokoro/dusky_main.py" --config "%E/dusky-kokoro/config.toml" --socket "%t/dusky-kokoro/control.sock" daemon
WorkingDirectory=%h/contained_apps/uv/dusky_kokoro
Environment=PYTHONUNBUFFERED=1
Environment="DUSKY_CONFIG=%E/dusky-kokoro/config.toml"
Restart=on-failure
RestartSec=1
TimeoutStartSec=120
TimeoutStopSec=10
KillMode=mixed
UMask=0077
OOMScoreAdjust=100

[Install]
# Socket-activated on purpose: enable dusky_kokoro.socket, not this unit.
