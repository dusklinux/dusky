# ~/.config/systemd/user/dusky_kokoro.socket
#
# Socket-activated control plane for Dusky Kokoro TTS.
# Enable this unit, never dusky_kokoro.service directly:
#   systemctl --user enable --now dusky_kokoro.socket
[Unit]
Description=Dusky Kokoro TTS control socket

[Socket]
ListenStream=%t/dusky-kokoro/control.sock
SocketMode=0600
DirectoryMode=0700
Backlog=64
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
