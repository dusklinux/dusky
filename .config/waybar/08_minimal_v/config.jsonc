//Minimal Vertical
{
    "layer": "top",
    "position": "right",
    "spacing": 0,
    "width": 30, // Slightly wider to fit the numbers comfortably
    "margin-top": 5,
    "margin-bottom": 5,
    "margin-left": 4,
    "margin-right": 4,
    "fixed-center": true,
    "reload_style_on_change": true,

    // ===================================================================
    // MODULE LAYOUT
    // ===================================================================
    "modules-left": [
        "group/clock-drawer"
        //"group/stats"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "group/media-drawer",
        "battery",
        "group/power-drawer"
    ],

    // ===================================================================
    // MODULE GROUPS (DRAWERS)
    // ===================================================================

    "group/clock-drawer": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration": 300,
            "children-class": "clock-drawer",
            "transition-left-to-right": true
        },
        "modules": [
            "clock",
            "custom/notification",
            "custom/updates"
        ]
    },

    "group/media-drawer": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration": 300,
            "children-class": "media-drawer",
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "backlight",
            "bluetooth",
            "custom/network"
        ]
    },

    "group/power-drawer": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration": 300,
            "children-class": "power-drawer",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/inhibit-suspend"
        ]
    },

    "group/stats": {
        "orientation": "vertical",
        "modules": [ "cpu", "memory", "custom/temperature" ]
    },

    // ===================================================================
    // MODULE CONFIGURATION
    // ===================================================================

    "hyprland/workspaces": {
        //"format": "{name}",
        "format": "",
        "on-click": "activate",
        "sort-by": "default",
        "persistent-workspaces": {},
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "cpu": {
        "justify": "center",
        "format": "\n{usage}",
        "interval": 2,
        "on-click": "dusky-run kitty --class htop -e htop",
        "tooltip-format": "CPU: {usage}%",
        "states": {
            "critical": 80
        }
    },

    "memory": {
        "justify": "center",
        "format": "\n{percentage}",
        "interval": 2,
        "on-click": "dusky-run kitty --class dusky_disk_monitor_io.py -e $HOME/user_scripts/drives/dusky_disk_monitor_io.py",
        "tooltip-format": "Used: {used}GiB",
        "states": {
            "critical": 80
        }
    },

    "custom/temperature": {
        "justify": "center",
        "exec": "\"$HOME/user_scripts/waybar/temperature.sh\" 10 80",
        "return-type": "json",
        "format": "{icon}\n{text}",
        "format-icons": { "default": "", "critical": "🔥" },
        "hide-empty-text": true,
        "restart-interval": 5
    },

    "clock": {
        "justify": "center",
        "format": "{:%I\n%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "dusky-run gnome-clocks",
        "interval": 60,
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffb786'><b>{}</b></span>",
                "days": "<span color='#e2e2e2'>{}</span>",
                "weeks": "<span color='#c9ca93'>W{}</span>",
                "weekdays": "<span color='#ffb786'><b>{}</b></span>",
                "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/notification": {
        "justify": "center",
        "align": 0.5,
        "tooltip-format": "{tooltip}\n\nLeft Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb",
        "format": "{}",
        "return-type": "json",
        "exec-if": "command -v makoctl >/dev/null 2>&1",
        "exec": "~/user_scripts/waybar/mako.sh --vertical",
        "interval": 2,
        "on-click": "~/user_scripts/rofi/rofi_mako.sh",
        "on-click-middle": "~/user_scripts/waybar/mako.sh --clear && pkill -RTMIN+8 waybar",
        "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar",
        "signal": 8,
        "escape": true
    },

    "custom/updates": {
        "justify": "center",
        "align": 0.5,
        "exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_v 2>/dev/null",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "dusky-run kitty --class system_update.sh --hold -e ~/user_scripts/update_dusky/system_update.sh --all"
    },

    "pulseaudio": {
        // Stacked: Icon on top, Volume % below
        "justify": "center",
        "format": "{icon}\n{volume}",
        "format-muted": "󰖁",
        "on-click": "dusky-run pavucontrol",
        "format-icons": ["", "", ""],
        "tooltip-format": "Volume: {volume}%"
    },

    "backlight": {
        "justify": "center",
        "align": 0.5,
        "format": "{icon}\n{percent}",
        "format-icons": ["","","","","","","","","","","","","","",""],
        "tooltip": true,
        "tooltip-format": "LMB: Brightness Slider\nRMB: hyprsunset Slider\nMMB: Shaders",
        "on-click": "\"$HOME/.local/bin/dusky-tray\"",
        "on-click-right": "\"$HOME/.local/bin/dusky-tray\"",
        "on-click-middle": "dusky-run \"$HOME/user_scripts/rofi/shader_menu.sh\"",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "min-length": 4,
        "interval": 60
    },

    "bluetooth": {
        "justify": "center",
        "align": 0.5,
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "dusky-run blueman-manager",
        "on-click-right": "dusky-run kitty --class bluetui -e bluetui"
    },

    "custom/network": {
        "justify": "center",
        "return-type": "json",
        "exec": "$HOME/user_scripts/waybar/network/network_meter_calling.sh --vertical",
        "interval": 1,
        "on-click": "foot --app-id=dusky_tui python $HOME/user_scripts/dusky_tui/python/main/main.py $HOME/user_scripts/network_manager/tui_dusky_network.py",
        "on-click-right": "nmcli radio wifi on",
        "on-click-middle": "nmcli radio wifi off"
    },

    "battery": {
        // Stacked: Icon on top, Capacity % below
        "justify": "center",
        "format": "{icon}\n{capacity}",
        "format-charging": "\n{capacity}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 5,
        "tooltip-format": "{timeTo}\nHealth: {health}%"
    },

    "custom/power": {
        "justify": "center",
        "format": "",
        "tooltip": true,
        "tooltip-format": "Power Menu\n RMB - Control Center",
        "on-click": "dusky-run ~/user_scripts/wlogout/wlogout_scale.sh",
        "on-click-right": "dusky-run python3 ~/user_scripts/dusky_system/control_center/dusky_control_center.py"
    },

    "custom/inhibit-suspend": {
        "justify": "center",
        "align": 0.5,
        "format": "{}",
        "exec": "if pgrep -x 'hypridle' > /dev/null;\nthen echo '{\"text\": \"󰌾\", \"tooltip\": \"Suspend is enabled.\\nClick to disable.\", \"class\": \"enabled\"}';\nelse echo '{\"text\": \"\", \"tooltip\": \"Suspend is disabled.\\nClick to enable.\", \"class\": \"disabled\"}';\nfi",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "dusky-run \"$HOME/user_scripts/waybar/toggle_hypridle.sh\"",
        "escape": true
    }
}
