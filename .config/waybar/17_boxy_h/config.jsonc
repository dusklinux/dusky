{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 0,
  "margin": 0,
  "modules-left": [
    "clock",
    "hyprland/window"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "custom/inhibit-suspend"
  ],
  "modules-right": [
    "backlight",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": []
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 45,
    "rewrite": {
      " - ": "",
      "(.*?) - Chromium - chromium": " Chromium ",
      "(.*chrome)...(.*)": " Chrome ",
      "(.*) - Obsidian - .* - obsidian": " Obsidian ",
      "(.*nvim)...(.*)": " nvim ",
      "(.*code) - (.*)": " VSCode ",
      "^.*btop( .*|$)": " BTOP ",
      "^.*cmatrix( .*|$)": " CMATRIX ",
      "(.*) - Spotify": " Spotify ",
      "(.*) - com.mitchellh.ghostty": " Ghostty ",
      "(.*) - Alacritty": " Alacritty ",
      "(.*) - BeeperTexts": " Beeper ",
      "(.*Discord)...(.*).. (.*)": " Discord ",
      "(.*) - org.gnome.Nautilus": " Nautilus ",
      "(.*) - fish": " fish ",
      "(.*Steam)...(.*)": " Steam "
    }
  },
  "backlight": {
    "format": "{icon} {percent}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%"
  },
  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "on-click-right": "dusky-run kitty --class htop -e htop"
  },
  "memory": {
    "interval": 2,
    "format": "󰍛 {percentage}%",
    "on-click-right": "dusky-run kitty --class dusky_disk_monitor_io.py -e $HOME/user_scripts/drives/dusky_disk_monitor_io.py",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "clock": {
      "format": "{:%I:%M %p  %a %e }",
      "format-alt": "{:%A %d/%m/%Y}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
          "mode": "year",
          "mode-mon-col": 3,
          "format": {
              "months": "<span color='#ffb786'><b>{}</b></span>",
              "days": "<span color='#e2e2e2'>{}</span>",
              "weeks": "<span color='#c9ca93'>W{}</span>",
              "weekdays": "<span color='#ffb786'><b>{}</b></span>",
              "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
          }
      },
      "actions": {
          "on-click-right": "mode",
          "on-scroll-up": "shift_up",
          "on-scroll-down": "shift_down"
      }
  },
  "custom/inhibit-suspend": {
    "format": "{}",
    "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"󰌾\", \"tooltip\": \"Auto-suspend ENABLED\\nClick to disable hypridle\", \"class\": \"enabled\"}'; else echo '{\"text\": \"󰅶\", \"tooltip\": \"Auto-suspend DISABLED\\nClick to enable hypridle\", \"class\": \"disabled\"}'; fi",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "on-click": "dusky-run ~/user_scripts/waybar/toggle_hypridle.sh",
    "escape": true
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "foot --app-id=dusky_tui python $HOME/user_scripts/dusky_tui/python/main/main.py $HOME/user_scripts/network_manager/tui_dusky_network.py"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "󰂄",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󱟢",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "dusky-run blueman-manager",
    "on-click-right": "dusky-run kitty --class bluetui -e bluetui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "dusky-run pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    }
  }
}
