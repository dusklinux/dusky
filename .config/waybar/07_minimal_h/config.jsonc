// Minimal Horizontal - Drawer Edition
{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 0,
    "margin-top": 5,
    "margin-bottom": 5,
    "margin-left": 4,
    "margin-right": 4,
    "fixed-center": true,

    // ===================================================================
    // MODULE LAYOUT
    // ===================================================================
    "modules-left": [
        "group/clock-drawer",
        "group/notif-drawer"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "group/audio-drawer",
        "group/battery-drawer",
        "group/power-drawer"
    ],

    // ===================================================================
    // GROUP / DRAWER CONFIGURATION
    // ===================================================================

    "group/clock-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "clock-drawer",
            "click-to-reveal": false,
            "transition-left-to-right": true
        },
        "modules": ["clock", "custom/weather", "custom/net-speed"]
    },

    "group/notif-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "notif-drawer",
            "click-to-reveal": false,
            "transition-left-to-right": true
        },
        "modules": ["custom/notification", "custom/updates"]
    },

    "group/audio-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "audio-drawer",
            "click-to-reveal": false,
            "transition-left-to-right": false
        },
        "modules": ["pulseaudio", "bluetooth", "network"]
    },

    "group/battery-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "battery-drawer",
            "click-to-reveal": false,
            "transition-left-to-right": false
        },
        "modules": ["battery", "cpu", "memory"]
    },

    "group/power-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "power-drawer",
            "click-to-reveal": false,
            "transition-left-to-right": false
        },
        "modules": ["custom/power", "custom/inhibit-suspend"]
    },

    // ===================================================================
    // MODULE CONFIGURATION
    // ===================================================================

    "hyprland/workspaces": {
        "format": "",
        "on-click": "activate",
        "sort-by": "default",
        "persistent-workspaces": {},
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "clock": {
        "format": "{:%I:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "dusky-run gnome-clocks",
        "interval": 60,
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffb786'><b>{}</b></span>",
                "days": "<span color='#e2e2e2'>{}</span>",
                "weeks": "<span color='#c9ca93'>W{}</span>",
                "weekdays": "<span color='#ffb786'><b>{}</b></span>",
                "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/weather": {
        "format": "{}",
        "exec": "python3 \"$HOME/user_scripts/waybar/weather.py\"",
        "interval": 600,
        "return-type": "json"
    },

    "custom/net-speed": {
        "exec": "$HOME/user_scripts/waybar/network/network_meter_calling.sh --horizontal",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "tooltip": true
    },

    "custom/notification": {
        "format": "{}",
        "return-type": "json",
        "exec-if": "command -v makoctl >/dev/null 2>&1",
        "exec": "~/user_scripts/waybar/mako.sh --horizontal",
        "interval": 2,
        "tooltip-format": "{tooltip}\n\nLeft Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb",
        "on-click": "~/user_scripts/rofi/rofi_mako.sh",
        "on-click-middle": "~/user_scripts/waybar/mako.sh --clear && pkill -RTMIN+8 waybar",
        "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar",
        "signal": 8,
        "escape": true
    },

    "custom/updates": {
        "exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "dusky-run kitty --class system_update.sh --hold -e ~/user_scripts/update_dusky/system_update.sh --all"
    },

    "pulseaudio": {
        "format": "{icon} ",
        "format-muted": "󰖁",
        "on-click": "dusky-run pavucontrol",
        "format-icons": ["", "", ""],
        "tooltip-format": "Volume: {volume}%"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "󰂱 {device_alias}",
        "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
        "on-click": "dusky-run blueman-manager",
        "on-click-right": "dusky-run kitty --class bluetui -e bluetui"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-linked": "󰈁",
        "tooltip-format-wifi": "󰤨 {essid}\n󱑽 {signalStrength}%\n󰩟 {ipaddr}",
        "tooltip-format-ethernet": "󰈀 Ethernet\n󰩟 {ipaddr}",
        "tooltip-format-disconnected": "󰤭 Disconnected",
        "on-click": "foot --app-id=dusky_tui python $HOME/user_scripts/dusky_tui/python/main/main.py $HOME/user_scripts/network_manager/tui_dusky_network.py"
    },

    "battery": {
        "format": "{icon} {capacity}",
        "format-charging": " {capacity}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 5,
        "tooltip-format": "{timeTo}\nHealth: {health}%"
    },

    "cpu": {
        "format": " {usage}",
        "interval": 2,
        "on-click": "dusky-run kitty --class htop -e htop",
        "tooltip-format": "CPU: {usage}%",
        "states": {
            "critical": 80
        }
    },

    "memory": {
        "format": " {percentage}",
        "interval": 2,
        "on-click": "dusky-run kitty --class dusky_disk_monitor_io.py -e $HOME/user_scripts/drives/dusky_disk_monitor_io.py",
        "tooltip-format": "Used: {used}GiB",
        "states": {
            "critical": 80
        }
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Power Menu\nLMB: Power Menu\nRMB: Dusky Center",
        "on-click": "dusky-run ~/user_scripts/wlogout/wlogout_scale.sh",
        "on-click-right": "\"$HOME/.local/bin/dusky-center\""
    },

    "custom/inhibit-suspend": {
        "format": "{}",
        "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"󰾪\", \"tooltip\": \"Idle enabled. Click to disable.\", \"class\": \"enabled\"}'; else echo '{\"text\": \"󰅶\", \"tooltip\": \"Idle disabled. Click to enable.\", \"class\": \"disabled\"}'; fi",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "dusky-run ~/user_scripts/waybar/toggle_hypridle.sh",
        "escape": true
    }
}
