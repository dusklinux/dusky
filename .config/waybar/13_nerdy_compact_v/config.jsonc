[
    {
        "layer": "top",
        "position": "left",
        "spacing": 0,
        "width": 0,
        "margin-top": 0,
        "margin-bottom": 0,
        "margin-left": 0,
        "margin-right": 0,
        "fixed-center": true,
        "reload_style_on_change": true,

        "modules-left": [
            "battery",
            "group/media",
            "group/hardware"
        ],

        "modules-center": [
            "hyprland/workspaces"
        ],

        "modules-right": [
            "group/updates-drawer",
            "custom/notification",
            "custom/theme",
            "custom/network",
            "clock",
            "tray",
            "custom/inhibit-suspend",
            "custom/power"
        ],

        "group/media": {
            "orientation": "inherit",
            "modules": [
                "pulseaudio",
                "backlight"
            ]
        },

        "group/hardware": {
            "orientation": "inherit",
            "modules": [
                "cpu",
                "memory",
                "custom/temperature"
            ]
        },

        "group/updates-drawer": {
            "orientation": "inherit",
            "drawer": {
                "transition-duration": 400,
                "children-class": "updates-drawer",
                "click-to-reveal": false,
                "transition-left-to-right": true
            },
            "modules": [
                "custom/updates-trigger",
                "custom/updates"
            ]
        },

        "hyprland/workspaces": {
            "on-click": "activate",
            "all-outputs": true,
            "sort-by": "default",
            "format": "{id}",
            "persistent-workspaces": {
                 "*": 5
            },
            "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
            "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
        },

        "battery": {
            "justify": "center",
            "align": 0.5,
            "format": "{icon}\n{capacity}\n{power:.0f}W",
            "format-charging": "\n+{capacity}\n{power:.0f}W",
            "format-plugged": "\n{capacity}",
            "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "interval": 10,
            "states": {
                "warning": 40,
                "critical": 20
            },
            "tooltip-format": "{timeTo}\nHealth 󱟦 {health}%\nPower Draw {power:.2f} W",
            "on-click": "dusky-run kitty --class power_saver.sh --hold -e \"$HOME/user_scripts/battery/power_saver/power_saver.py\" --interactive",
            "on-click-right": "dusky-run kitty --class dusky_tui -e python3 $HOME/user_scripts/hypridle/tui_dusky_hypridle.py"
        },

        "pulseaudio": {
            "justify": "center",
            "align": 0.5,
            "format": "{icon}\n{volume}",
            "format-muted": "󰖁",
            "on-click": "dusky-run pavucontrol",
            "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
            "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
            "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
            "format-icons": [
                "󰖁",
                "",
                ""
            ],
            "tooltip": true,
            "tooltip-format": "{desc}\n\nLMB: pavucontrol\nRMB: cava\nMMB: Mute",
            "on-click-right": "dusky-run kitty --class cava -e cava"
        },

        "backlight": {
            "justify": "center",
            "align": 0.5,
            "format": "{icon}\n{percent}",
            "format-icons": ["","","","","","","","","","","","","","",""],
            "tooltip": true,
            "tooltip-format": "LMB: Brightness Slider\nRMB: hyprsunset Slider\nMMB: Shaders",
            "on-click": "\"$HOME/.local/bin/dusky-tray\"",
            "on-click-right": "\"$HOME/.local/bin/dusky-tray\"",
            "on-click-middle": "dusky-run \"$HOME/user_scripts/rofi/shader_menu.sh\"",
            "on-scroll-up": "brightnessctl set +5%",
            "on-scroll-down": "brightnessctl set 5%-",
            "interval": 60
        },

        "cpu": {
            "justify": "center",
            "align": 0.5,
            "format": "\n{usage}",
            "tooltip": true,
            "on-click": "dusky-run kitty --class htop -e htop",
            "on-click-right": "dusky-run kitty --class sysbench_benchmark.py -e \"$HOME/user_scripts/performance/sysbench_benchmark.py\"",
            "tooltip-format": "CPU: {usage}%\nAvg Freq: {avg_frequency}GHz",
            "interval": 2
        },

        "memory": {
            "justify": "center",
            "align": 0.5,
            "format": "\n{percentage}",
            "interval": 2,
            "on-click": "dusky-run kitty --class dusky_disk_monitor_io.py -e \"$HOME/user_scripts/drives/dusky_disk_monitor_io.py\"",
            "states": {
               "critical": 80
            },
            "tooltip": true,
            "tooltip-format":"Used {used} GiB\nAvail {avail} Gib\nSwap {swapUsed} GiB"
        },

        "custom/temperature": {
            "justify": "center",
            "align": 0.5,
            "exec": "\"$HOME/user_scripts/waybar/temperature.sh\" 2 65",
            "return-type": "json",
            "format": "{icon}\n{text}",
            "format-icons": { "default": "", "critical": "🔥" },
            "hide-empty-text": true,
            "restart-interval": 5
        },

        "clock": {
            "justify": "center",
            "align": 0.5,
            "format": "{:%I\n%M}",
            "tooltip-format": "<tt>{calendar}</tt>",
            "interval": 60,
            "on-click": "dusky-run gnome-clocks",
            "on-click-middle": "dusky-run kitty --class peaclock -e peaclock",
            "calendar": {
                "mode": "year",
                "mode-mon-col": 3,
                "weeks-pos": "right",
                "on-scroll": 1,
                "format": {
                    "months": "<span color='#ffead3'><b>{}</b></span>",
                    "days": "<span color='#ecc6d9'><b>{}</b></span>",
                    "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                    "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                    "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
                }
            },
            "actions": {
                "on-click-right": "mode",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            }
        },


        "custom/network": {
            "justify": "center",
            "align": 0.5,
            "return-type": "json",
            "tooltip": true,
            "tooltip-format": "{tooltip}\n\nLMB: Dusky Network\nRMB: WiFi ON\nMMB: WiFi OFF",
            "on-click": "foot --app-id=dusky_tui python $HOME/user_scripts/dusky_tui/python/main/main.py $HOME/user_scripts/network_manager/tui_dusky_network.py",
            "on-click-right": "systemctl --user restart network_meter.service && nmcli radio wifi on && notify-send 'Turned ON WiFi'",
            "on-click-middle": "nmcli radio wifi off && notify-send 'Turned OFF WiFi'",
            "interval": 2,
            "exec": "$HOME/user_scripts/waybar/network/network_meter_calling.sh --vertical"
        },

        "custom/updates-trigger": {
            "justify": "center",
            "align": 0.5,
            "format": "",
            "exec": "grep -qE '\"class\"[[:space:]]*:[[:space:]]*\"(pending|unknown)\"' \"$HOME/.config/dusky/settings/waybar_update_counter_v\" 2>/dev/null && printf '\\n'",
            "interval": 5,
            "tooltip": false
        },

        "custom/updates": {
            "justify": "center",
            "align": 0.5,
            "exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_v 2>/dev/null",
            "return-type": "json",
            "format": "{}",
            "tooltip": true,
            "on-click": "dusky-run kitty --class system_update.sh --hold -e ~/user_scripts/update_dusky/system_update.sh --all"
        },

        "custom/notification": {
            "justify": "center",
            "align": 0.5,
            "tooltip-format": "{tooltip}\n\nLeft Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb",
            "format": "{}",
            "return-type": "json",
            "exec-if": "command -v makoctl >/dev/null 2>&1",
            "exec": "~/user_scripts/waybar/mako.sh --vertical",
            "interval": 2,
            "on-click": "~/user_scripts/rofi/rofi_mako.sh",
            "on-click-middle": "~/user_scripts/waybar/mako.sh --clear && pkill -RTMIN+8 waybar",
            "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar",
            "signal": 8,
            "escape": true
        },

        "custom/inhibit-suspend": {
            "justify": "center",
            "align": 0.5,
            "format": "{}",
            "exec": "if pgrep -x 'hypridle' > /dev/null;\nthen echo '{\"text\": \"󰌾\", \"tooltip\": \"Suspend is enabled.\\nClick to disable.\", \"class\": \"enabled\"}';\nelse echo '{\"text\": \"\", \"tooltip\": \"Suspend is disabled.\\nClick to enable.\", \"class\": \"disabled\"}';\nfi",
            "return-type": "json",
            "interval": 5,
            "signal": 9,
            "on-click": "dusky-run \"$HOME/user_scripts/waybar/toggle_hypridle.sh\"",
            "escape": true
        },

        "custom/theme": {
            "justify": "center",
            "align": 0.5,
            "format": "",
            "tooltip": true,
            "tooltip-format": "Wallpaper and Appearance\nLMB: Dusky Papers\nRMB: Light Mode\nMMB: Dusky Papers",
            "on-click": "\"$HOME/.local/bin/dusky-papers\"",
            "on-click-right": "dusky-run \"$HOME/user_scripts/theme_matugen/theme_ctl.sh\" set --mode light",
            "on-click-middle": "\"$HOME/.local/bin/dusky-papers\""
        },



        "custom/power": {
            "justify": "center",
            "align": 0.5,
            "format": "",
            "tooltip": true,
            "tooltip-format": "Power Menu",
            "on-click": "dusky-run \"$HOME/user_scripts/wlogout/wlogout_scale.sh\""
        },



        "tray": {
            "icon-size": 18,
            "show-passive-items": true,
            "spacing": 1,
            "rotate": 90
        }
    }
]
