{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 3,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": [
        "group/power",
        "hyprland/workspaces",
        "group/updates-drawer"
    ],
    "modules-center": [
        "backlight",
        "clock",
        "pulseaudio"
    ],
    "modules-right": [
        "custom/net-speed",
        "battery",
        "custom/notification"
    ],

    // === GROUP: POWER (The Drawer) ===
    "group/power": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "power-drawer",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/arch",
            "custom/lock",
            "custom/inhibit-suspend",
            "custom/logout",
            "custom/reboot",
            "custom/shutdown"
        ]
    },
    "custom/arch": {
        "format": "󰌽",
        "tooltip-format": "LMB: Dusky Center\nRMB: Dusky Tray",
        "on-click": "\"$HOME/.local/bin/dusky-center\"",
        "on-click-right": "\"$HOME/.local/bin/dusky-tray\""
    },
    "custom/lock": {
        "format": "󰌾",
        "tooltip-format": "Lock Screen",
        "on-click": "dusky-run $HOME/user_scripts/hyprlock/lock.sh"
    },
    "custom/inhibit-suspend": {
        "format": "{}",
        "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"󰾪\", \"tooltip\": \"Idle enabled. Click to disable.\", \"class\": \"enabled\"}'; else echo '{\"text\": \"󰅶\", \"tooltip\": \"Idle disabled. Click to enable.\", \"class\": \"disabled\"}'; fi",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "dusky-run ~/user_scripts/waybar/toggle_hypridle.sh",
        "escape": true
    },
    "custom/logout": {
        "format": "󰍃",
        "tooltip-format": "Logout",
        "on-click": "hyprctl dispatch 'hl.dsp.exit()'"
    },
    "custom/reboot": {
        "format": "󰜉",
        "tooltip-format": "Reboot",
        "on-click": "systemctl reboot"
    },
    "custom/shutdown": {
        "format": "󰐥",
        "tooltip-format": "Shutdown",
        "on-click": "systemctl poweroff"
    },

    // === GROUP: UPDATES (Dynamic Drawer) ===
    "group/updates-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "updates-drawer",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/updates-trigger",
            "custom/updates"
        ]
    },
    "custom/updates-trigger": {
        "format": "",
        "exec": "grep -qE '\"class\"[[:space:]]*:[[:space:]]*\"(pending|unknown)\"' \"$HOME/.config/dusky/settings/waybar_update_counter_h\" 2>/dev/null && printf '\\n'",
        "interval": 5,
        "tooltip": false
    },
    "custom/updates": {
        "exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "dusky-run kitty --class system_update.sh --hold -e ~/user_scripts/update_dusky/system_update.sh --all"
    },

    // === MODULES: LEFT ===
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    // === MODULES: CENTER ===
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "LMB: Brightness Slider\nRMB: hyprsunset Slider\nMMB: Shaders",
        "on-click": "\"$HOME/.local/bin/dusky-tray\"",
        "on-click-right": "\"$HOME/.local/bin/dusky-tray\"",
        "on-click-middle": "dusky-run ~/user_scripts/rofi/shader_menu.sh",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "󰃭 {:%A, %B %d}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "dusky-run gnome-clocks",
        "on-click-middle": "dusky-run kitty --class clock -e peaclock",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffb77a'><b>{}</b></span>",
                "days": "<span color='#efe0d6'>{}</span>",
                "weeks": "<span color='#c3cb97'>W{}</span>",
                "weekdays": "<span color='#ffb77a'><b>{}</b></span>",
                "today": "<span color='#19120c' background='#ffb77a'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "tooltip-format": "{desc}\nVolume: {volume}%\n\n LMB  Pavucontrol\n MMB  Mute Toggle\n RMB  Cava",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "dusky-run pavucontrol",
        "on-click-right": "dusky-run kitty --class cava -e cava",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },

    // === MODULES: RIGHT ===
    "custom/net-speed": {
        "exec": "$HOME/user_scripts/waybar/network/network_meter_calling.sh --horizontal",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "tooltip": true
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": " {icon} {capacity} -{power:.0f}W",
        "format-charging": "  +{capacity} +{power:.0f}W",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-click": "dusky-run kitty --class power_saver.sh --hold -e \"$HOME/user_scripts/battery/power_saver/power_saver.py\" --interactive",
        "on-click-right": "dusky-run kitty --class dusky_tui -e python3 $HOME/user_scripts/hypridle/tui_dusky_hypridle.py",
        "tooltip-format": "{timeTo}\n\n󱟦 Health: {health}%\n󱐋 Power: {power:.2f}W"
    },
    "custom/notification": {
        "format": "{}",
        "return-type": "json",
        "exec-if": "command -v makoctl >/dev/null 2>&1",
        "exec": "~/user_scripts/waybar/mako.sh",
        "on-click": "~/user_scripts/rofi/rofi_mako.sh",
        "on-click-middle": "~/user_scripts/waybar/mako.sh --clear && pkill -RTMIN+8 waybar",
        "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar",
        "signal": 8,
        "escape": true,
        "tooltip-format": "{tooltip}\n\n LMB  Toggle Panel\n MMB  Clear All\n RMB  Do Not Disturb",
        "interval": 2
    }
}
