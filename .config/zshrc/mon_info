# Monitor information from Hyprland's structured IPC output.
mon_info() {
  emulate -L zsh
  local response rows
  local color=0
  [[ -t 1 ]] && color=1

  # Batch replies are separate JSON documents, not one enclosing array.
  if ! response=$(hyprctl -j --batch 'monitors; getoption debug:vfr'); then
    print -ru2 -- "mon_info: Hyprland query failed: $response"
    return 1
  fi

  # Validate before rendering so a failed query cannot look like disabled VFR
  # or produce a partially successful report. TSV escapes embedded separators.
  if ! rows=$(jq -ers '
    def positive: type == "number" and . > 0;
    if length != 2 or (.[0] | type) != "array"
       or (.[1].bool | type) != "boolean" then
      error("expected monitor array and VFR boolean")
    else . end
    | .[0] as $monitors | .[1].bool as $vfr
    | if all($monitors[];
        (.name | type == "string" and length > 0) and
        (.width | positive and floor == .) and
        (.height | positive and floor == .) and
        (.scale | positive) and
        (.physicalWidth // 0 | type == "number" and . >= 0 and floor == .) and
        (.physicalHeight // 0 | type == "number" and . >= 0 and floor == .) and
        (.refreshRate | type == "number" and . >= 0) and
        (.transform | type == "number" and . >= 0 and . <= 7 and floor == .) and
        (.focused | type == "boolean") and (.vrr | type == "boolean"))
      then . else error("invalid monitor geometry or state") end
    | ($monitors[] | [
        "monitor", .name, .make // "", .model // "",
        .width, .height, .refreshRate, .scale,
        .physicalWidth // 0, .physicalHeight // 0, .transform,
        (.activeWorkspace | [.address // (.id // "" | tostring), .name // ""]
          | if .[0] == .[1] then [.[0]] else . end
          | map(select(. != "")) | join(" ")),
        .colorManagementPreset // "Unknown", .mirrorOf // "none",
        .vrr, .focused
      ] | @tsv), (["vfr", $vfr] | @tsv)
  ' <<< "$response"); then
    print -ru2 -- 'mon_info: invalid Hyprland response'
    return 1
  fi

  LC_ALL=C awk -F '\t' -v color="$color" '
    function gcd(a, b, t) {
      while (b) { t = a % b; a = b; b = t }
      return a
    }

    function row(key, value, style, last) {
      printf " %s%s%s %s%-15s%s : %s%s%s\n", dim,
        (last ? "╰─" : "├─"), rst, keycolor, key, rst, style, value, rst
    }

    BEGIN {
      if (color) {
        rst = "\033[0m"; dim = "\033[2;37m"; hdr = "\033[1;36m"
        keycolor = "\033[1;34m"; val = "\033[1;37m"
        met = "\033[1;33m"; pos = "\033[1;32m"; err = "\033[1;31m"
      }
      rotation[0] = "0° (Normal)"
      rotation[1] = "90°"
      rotation[2] = "180°"
      rotation[3] = "270°"
      rotation[4] = "0° (Reflected)"
      rotation[5] = "90° (Reflected)"
      rotation[6] = "180° (Reflected)"
      rotation[7] = "270° (Reflected)"
    }

    $1 == "monitor" {
      w = $5 + 0; h = $6 + 0; scale = $8 + 0
      mw = $9 + 0; mh = $10 + 0; transform = $11 + 0
      printf "%s󰍹 %s%s\n", hdr, $2, rst
      hardware = $3 ($3 != "" && $4 != "" ? " " : "") $4
      row("Hardware", hardware != "" ? hardware : "Unknown", val)
      row("Resolution", sprintf("%dx%d%s @ %s%.2f Hz", w, h, rst, met, $7), val)
      row("Scaling", $8 (scale != int(scale) ? " (Fractional)" : ""), val)

      # Hyprland rounds transformed pixel dimensions divided by scale.
      effw = int((transform % 2 ? h : w) / scale + 0.5)
      effh = int((transform % 2 ? w : h) / scale + 0.5)
      row("Effective Res", sprintf("%dx%d", effw, effh), val)
      if (mw > 0 && mh > 0) {
        diagonal = sqrt(mw^2 + mh^2) / 25.4
        row("Physical Size", sprintf("%dx%d mm%s (%s%.2f\"%s)", mw, mh, rst, met, diagonal, rst), val)
        row("Pixel Density", sprintf("%.1f PPI", sqrt(w^2 + h^2) / diagonal), met)
      } else {
        row("Physical Size", "Unknown (not reported)", dim)
      }

      g = gcd(w, h)
      aspect = sprintf("%d:%d%s (%s%.3f:1%s)", w / g, h / g, rst, met, w / h, rst)
      if (w == 1366 && h == 768) aspect = "683:384" rst " (" met "~16:9" rst ")"
      row("Aspect Ratio", aspect, val)
      row("Rotation", rotation[transform], val)
      row("Workspace", $12 != "" ? $12 : "None", val)
      row("Color Profile", $13 != "" ? $13 : "Unknown", val)
      row("Mirroring", $14 != "" && $14 != "none" ? "Monitor ID " $14 : "None", val)
      row("VRR", $15 == "true" ? "Enabled" : "Disabled", $15 == "true" ? pos : dim)
      row("Focused", $16 == "true" ? "Yes" : "No", $16 == "true" ? pos : dim, 1)
      print ""
      monitors++
    }

    $1 == "vfr" {
      if (!monitors) print "No active monitors.\n"
      printf "%sGlobal Settings%s\n", hdr, rst
      row("VFR", $2 == "true" ? "Enabled" : "Disabled", $2 == "true" ? pos : err, 1)
      print ""
    }
  ' <<< "$rows"
}

alias ms='mon_info'
