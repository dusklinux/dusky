# Keep package queries in the Bash script; Zsh only handles prompt insertion.
pkg() {
    emulate -L zsh
    local script="$HOME/user_scripts/pacman/dusky_packages.sh"
    local arg selection exit_status

    # Help and counted listings must stream directly to stdout.
    for arg in "$@"; do
        if [[ ${arg:l} == (help|-h|--help) || $arg =~ '^[1-9][0-9]*$' ]]; then
            command bash -- "$script" "$@"
            return $?
        fi
    done

    selection=$(command bash -- "$script" "$@")
    exit_status=$?
    (( exit_status == 0 )) || return "$exit_status"

    if [[ -o interactive && -t 1 ]]; then
        print -rz -- "$selection"
    else
        print -r -- "$selection"
    fi
}

# Arguments can appear in any order, including after a count.
_pkg() {
    _arguments '*:package query argument:(all explicit user hogs size big fat massive huge giant tiny small micro mini little new recent latest old ancient alpha name help --help -h --desktop)'
}
compdef _pkg pkg
