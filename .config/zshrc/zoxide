# Dusky zoxide module — source from ~/.zshrc after the fzf theme is loaded.
# Verified: zsh 5.9.2, zoxide 0.10.0, fzf 0.74.4 (zoxide/fzf optional).
# z/zi use upstream navigation and completion; builtin cd is untouched.
# A valid cache uses only zsh builtins: no subprocesses during warm startup.

# _ZO_ECHO and _ZO_RESOLVE_SYMLINKS affect GENERATED shell code; other
# zoxide settings below are read at runtime. Include generation settings
# in the cache signature whenever they change.
export _ZO_ECHO=1
export _ZO_EXCLUDE_DIRS="$HOME"
# This replaces FZF_DEFAULT_OPTS for zoxide, so compose the theme explicitly.
export _ZO_FZF_OPTS="--height=40% --layout=reverse --border=rounded --info=inline-right --scheme=path${DUSKY_FZF_COLORS:+ --color=$DUSKY_FZF_COLORS}"

() {
    emulate -L zsh
    setopt extendedglob noclobber no_clobber_empty
    zmodload zsh/parameter 2>/dev/null || return 0

    (( $+commands[zoxide] )) || return 0
    local bin=$commands[zoxide]
    local real=${bin:A}
    # :a makes a relative override safe for source/redirections and file tools.
    local cache=${${ZOXIDE_INIT_CACHE:-$HOME/.zoxide-init.zsh}:a}
    local sig end='# dusky-zoxide-end: v3' init tmp
    local -A info
    local -a trusted
    local -i cacheable=0 i

    if zmodload -F zsh/stat b:zstat 2>/dev/null &&
       zmodload -F zsh/files b:zf_mv b:zf_rm b:zf_chmod 2>/dev/null &&
       zstat -H info -- "$real" 2>/dev/null; then
        cacheable=1
        # Package upgrades can install binaries older than the cache. Identity
        # and metadata detect replacement without relying on newer mtimes.
        sig="# dusky-zoxide-sig: v3 ${(q)real} $info[device]:$info[inode]:$info[size]:$info[mtime]:$info[ctime] echo=1 resolve=${(q)_ZO_RESOLVE_SYMLINKS-}"
        # Regular, owned by this UID, neither group- nor world-writable.
        trusted=( "$cache"(N.U^WI) )
        if (( $#trusted )); then
            # zsh optimizes $(<file): one complete read, no subprocess.
            init=$(<"$cache")
            if [[ $init == "$sig"$'\n'*$'\n'"$end" ]] &&
               eval "$init" 2>/dev/null &&
               (( $+functions[z] && $+functions[zi] )); then
                return 0
            fi
        fi
    fi

    # Generate once, even when caching is unavailable. Never cache a failed,
    # empty, or syntactically invalid initialization.
    init=$("$bin" init zsh 2>/dev/null) || return 0
    [[ -n ${init//[[:space:]]/} ]] || return 0
    eval "$init" 2>/dev/null || return 0
    (( $+functions[z] && $+functions[zi] )) || return 0
    (( cacheable )) || return 0
    [[ ! -d $cache ]] || return 0

    # NOCLOBBER reserves a unique sibling; only remove a file we created.
    for (( i = 0; i < 16; ++i )); do
        tmp=$cache.tmp.$$.$RANDOM
        [[ ! -e $tmp && ! -L $tmp ]] || continue
        if print -rl -- "$sig" "$init" "$end" 2>/dev/null > "$tmp"; then
            # Ensure subsequent shells can use the cache even with umask 000.
            if ! { zf_chmod 600 "$tmp" &&
                   [[ ! -d $cache ]] &&
                   zf_mv -f -- "$tmp" "$cache"; } 2>/dev/null; then
                zf_rm -f -- "$tmp" 2>/dev/null
            fi
            break
        fi
        # A failed write can leave a partial file after a successful open.
        [[ -f $tmp && ! -L $tmp ]] && zf_rm -f -- "$tmp" 2>/dev/null
        break
    done
    return 0
}

# Keep existing user functions when zoxide is unavailable.
if (( ! $+functions[z] )); then
    function z() {
        emulate -L zsh
        case ${1-} in
            -h|--help)
                print -rl -- \
                    'z [--] PATH  cd to a directory (zoxide unavailable)' \
                    'z            cd ~' \
                    'z -          cd -' \
                    'Keyword search requires zoxide: pacman -S zoxide'
                return 0 ;;
            --)
                if (( $# != 2 )); then
                    print -ru2 -- 'z: expected exactly one directory after --'
                    return 1
                fi
                shift ;;
        esac
        if (( $# > 1 )); then
            print -ru2 -- 'z: multi-keyword jumps require zoxide; refusing cd old new semantics'
            return 1
        fi
        # Preserve cd diagnostics and exit status, including unset OLDPWD.
        builtin cd -- "$@"
    }
fi

if (( ! $+functions[zi] )); then
    function zi() {
        emulate -L zsh
        if [[ ${1-} == (-h|--help) ]]; then
            print -r -- 'zi KEYWORDS  interactive zoxide jump (requires zoxide and fzf)'
            return 0
        fi
        print -ru2 -- 'zi: zoxide initialization unavailable; interactive jump requires zoxide and fzf'
        return 1
    }
fi

# Sourcing this optional module must succeed when the real functions exist.
return 0
